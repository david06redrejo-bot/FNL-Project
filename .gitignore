# Python virtual environments and local configuration
.venv/
venv/
.env
.env.*

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.matplotlib-cache/
.cache/

# Jupyter
.ipynb_checkpoints/

# OS/editor generated files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Private raw/intermediate data. Keep folder placeholders.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Generated outputs. Keep folder placeholders.
outputs/eda/*
outputs/metrics/*
outputs/predictions/*
outputs/checkpoints/*
outputs/logs/*
!outputs/eda/.gitkeep
!outputs/metrics/.gitkeep
!outputs/predictions/.gitkeep
!outputs/checkpoints/.gitkeep
!outputs/logs/.gitkeep

# Large model artifacts
*.pt
*.pth
*.ckpt
*.safetensors
*.joblib
*.pkl

# Debug smoke-test submissions are generated artifacts.
submissions/*_debug_submission.csv

# Generated report artifacts
reports/compiled/*
!reports/compiled/.gitkeep
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz

# Local experiments and agent scratch files
experiments/
agent/
instructions/
